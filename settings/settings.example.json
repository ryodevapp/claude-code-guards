{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/**/.env"
      ],
      "denyWrite": [
        "~/**/.githooks",
        "~/Projects/*/.git/hooks",
        "~/Projects/*/.git/config",
        "~/Projects/*/.claude"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git stash clear*)",
      "Bash(sudo rm:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/**/.env)",
      "Edit(~/**/.githooks/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(gh repo delete*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git push * :*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh * --clobber*)",
      "Bash(gh config set*)",
      "Bash(gh release delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh run delete*)",
      "Bash(gh cache delete*)",
      "Bash(gh label delete*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh gist *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh auth token*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth setup-git*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "/Users/YOU/.claude/hooks/guard-delete.sh"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "/Users/YOU/.claude/hooks/guard-write.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
